generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                  Int         @id @default(autoincrement())
  nome                String
  email               String      @unique
  senha               String
  foto                String?
  resetTokenHash      String?     @unique
  resetTokenExpiresAt DateTime?
  // Incrementado sempre que a senha muda — tokens JWT emitidos antes disso
  // carregam a versão antiga e são recusados por authMiddleware.
  tokenVersion        Int         @default(0)
  createdAt           DateTime    @default(now())
  // Todo usuário pertence a exatamente uma família (a "família pessoal" criada no
  // registro, ou uma compartilhada depois de entrar com um código) — nunca mais de uma,
  // sem seletor de workspace.
  familiaId           Int
  familia             Familia     @relation(fields: [familiaId], references: [id], onDelete: Restrict)
  // "dono" pode remover membros, renomear a família e regenerar o código; "membro" só
  // mexe nos dados (criar/editar/excluir), igual a um dono, mas não na família em si.
  papelFamilia        String      @default("dono")
  transacoes          Transacao[]
  metas               Meta[]
  orcamentos          Orcamento[]
  recorrencias        Recorrencia[]
  contas              Conta[]
  transferencias      Transferencia[]
  conexoesBancarias   ConexaoBancaria[]
  categorias          Categoria[]
}

// Uma "carteira" compartilhada entre 1+ usuários. Toda visibilidade/posse de dado
// financeiro passa a ser por familiaId, não por usuarioId (que continua existindo nas
// tabelas abaixo só como atribuição — "quem lançou" — não como controle de acesso).
model Familia {
  id                Int               @id @default(autoincrement())
  nome              String
  // Código curto compartilhado fora do app (ex: WhatsApp) pra outra pessoa entrar —
  // sem convite por e-mail, sem token com expiração.
  codigo            String            @unique
  createdAt         DateTime          @default(now())
  membros           Usuario[]
  categorias        Categoria[]
  transacoes        Transacao[]
  contas            Conta[]
  conexoesBancarias ConexaoBancaria[]
  transferencias    Transferencia[]
  recorrencias      Recorrencia[]
  metas             Meta[]
  orcamentos        Orcamento[]
}

// Metadados de exibição (ícone/cor) por categoria — de propósito NÃO é uma foreign key
// de Transacao/Recorrencia/Orcamento, que continuam guardando categoria como texto livre
// (como sempre foi). Isso evita qualquer migração/backfill em cima de dados reais: uma
// categoria sem linha correspondente aqui simplesmente cai num ícone/cor padrão.
model Categoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  familiaId Int
  nome      String
  tipo      String
  icone     String   @default("💰")
  cor       String   @default("#6366f1")
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia   Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)

  @@unique([familiaId, nome, tipo])
}

model Transacao {
  id            Int          @id @default(autoincrement())
  usuarioId     Int
  familiaId     Int
  familia       Familia      @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  tipo          String
  valor         Decimal      @db.Decimal(12, 2)
  categoria     String
  descricao     String       @default("")
  data          String
  createdAt     DateTime     @default(now())
  // Atualizado automaticamente pelo Prisma em todo update() — usado só pra sinalizar "editada"
  // na lista; o que mudou de fato fica no histórico (TransacaoHistorico).
  updatedAt     DateTime     @default(now()) @updatedAt
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recorrenciaId Int?
  // SetNull (não Cascade): apagar a regra de recorrência não deve apagar o histórico
  // de transações já lançadas a partir dela.
  recorrencia   Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)
  contaId       Int
  conta         Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  // Preenchido só em transações vindas de sincronização Open Finance — usado pra nunca
  // importar a mesma transação duas vezes num novo sync (upsert idempotente).
  pluggyTransactionId String? @unique
  // Comprovante anexado (data URL base64, imagem ou PDF) — nunca incluído nas consultas
  // de listagem/export (só via GET /transactions/:id/anexo), pra não pesar a paginação.
  anexo     String?
  anexoNome String?
  historico TransacaoHistorico[]
}

// Um registro por edição que muda pelo menos um campo financeiro (tipo/valor/categoria/
// descricao/data/contaId) — não registra troca de anexo, pra não guardar base64 no histórico.
// "alteracoes" é a lista de { campo, de, para } daquela edição específica.
model TransacaoHistorico {
  id          Int       @id @default(autoincrement())
  transacaoId Int
  transacao   Transacao @relation(fields: [transacaoId], references: [id], onDelete: Cascade)
  alteracoes  Json
  createdAt   DateTime  @default(now())
}

// Conta/carteira do usuário (conta corrente, cartão, dinheiro em espécie...). saldoInicial
// é o valor que a conta já tinha antes de começar a ser rastreada aqui — o saldo exibido
// nunca é guardado, é sempre saldoInicial + receitas - despesas dessa conta (± transferências).
model Conta {
  id                     Int             @id @default(autoincrement())
  usuarioId              Int
  familiaId              Int
  nome                   String
  tipo                   String
  saldoInicial           Decimal         @db.Decimal(12, 2) @default(0)
  createdAt              DateTime        @default(now())
  usuario                Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia                Familia         @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  transacoes             Transacao[]
  transferenciasSaida    Transferencia[] @relation("TransferenciasSaida")
  transferenciasEntrada  Transferencia[] @relation("TransferenciasEntrada")
  recorrencias           Recorrencia[]
  // Preenchidos só quando a conta nasceu de uma sincronização Open Finance (Pluggy).
  // SetNull: apagar a conexão bancária não apaga a conta nem o histórico importado.
  pluggyAccountId        String?         @unique
  conexaoId              Int?
  conexao                ConexaoBancaria? @relation(fields: [conexaoId], references: [id], onDelete: SetNull)
}

// Uma conexão com um banco via Open Finance (Pluggy). Uma conexão pode alimentar mais de
// uma Conta local (ex: conta corrente + cartão de crédito do mesmo banco). Nenhum dado
// bancário sensível (senha, token de acesso ao banco) é guardado aqui — só o identificador
// do Item na Pluggy, que por si só não dá acesso a nada sem a API key do servidor.
model ConexaoBancaria {
  id                  Int      @id @default(autoincrement())
  usuarioId           Int
  familiaId           Int
  pluggyItemId        String   @unique
  nomeConector        String
  status              String
  erro                String?
  ultimaSincronizacao DateTime?
  createdAt           DateTime @default(now())
  usuario             Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia             Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  contas              Conta[]
}

// Movimentação entre duas contas do mesmo usuário — nunca gera Transacao (não é receita
// nem despesa de verdade, só troca de "bolso"), então não aparece nos relatórios de
// receita/despesa, só no saldo de cada conta envolvida.
model Transferencia {
  id             Int      @id @default(autoincrement())
  usuarioId      Int
  familiaId      Int
  contaOrigemId  Int
  contaDestinoId Int
  valor          Decimal  @db.Decimal(12, 2)
  data           String
  descricao      String   @default("")
  createdAt      DateTime @default(now())
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia        Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  contaOrigem    Conta    @relation("TransferenciasSaida", fields: [contaOrigemId], references: [id], onDelete: Cascade)
  contaDestino   Conta    @relation("TransferenciasEntrada", fields: [contaDestinoId], references: [id], onDelete: Cascade)
}

// Regra de recorrência mensal (aluguel, assinatura, salário...). As ocorrências não
// nascem daqui direto — são materializadas como Transacao normais (ver
// utils/materializeRecorrencias.js) sempre que o usuário acessa a tela de recorrências
// ou a lista de transações, sem depender de nenhum job/cron rodando no servidor.
model Recorrencia {
  id          Int         @id @default(autoincrement())
  usuarioId   Int
  familiaId   Int
  tipo        String
  valor       Decimal     @db.Decimal(12, 2)
  categoria   String
  descricao   String      @default("")
  diaDoMes    Int
  dataInicio  String
  dataFim     String?
  ativa       Boolean     @default(true)
  createdAt   DateTime    @default(now())
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia     Familia     @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  transacoes  Transacao[]
  contaId     Int
  conta       Conta       @relation(fields: [contaId], references: [id], onDelete: Cascade)
}

model Meta {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  familiaId Int
  titulo    String
  valorAlvo Decimal  @db.Decimal(12, 2)
  prazo     String?
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia   Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  aportes   Aporte[]
}

// Contribuições registradas manualmente pelo usuário — valorAtual de uma Meta é sempre
// a soma dos aportes, nunca um campo redundante na Meta (evita os dois ficarem dessincronizados).
model Aporte {
  id        Int      @id @default(autoincrement())
  metaId    Int
  valor     Decimal  @db.Decimal(12, 2)
  data      String
  descricao String   @default("")
  createdAt DateTime @default(now())
  meta      Meta     @relation(fields: [metaId], references: [id], onDelete: Cascade)
}

// Limite mensal fixo por categoria — vale todo mês até o usuário editar (não é um
// registro por mês). O gasto do mês é sempre calculado a partir das Transacoes, nunca
// guardado aqui.
model Orcamento {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  familiaId   Int
  categoria   String
  valorLimite Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  familia     Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  // Mês (YYYY-MM) do último aviso de orçamento estourado já enviado por e-mail — evita
  // mandar um e-mail novo a cada transação que continua estourando o mesmo orçamento no mês.
  ultimaNotificacaoMes String?

  @@unique([familiaId, categoria])
}
